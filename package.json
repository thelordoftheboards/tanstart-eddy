{
  "name": "tanstart-eddy",
  "version": "0.0.52",
  "private": false,
  "license": "unlicense",
  "author": {
    "name": "Alexander C",
    "url": "https://github.com/thelordoftheboards"
  },
  "type": "module",
  "scripts": {
    "auth:generate": "bunx auth@latest generate --config ./src/lib/auth/auth.ts --y --output ./src/lib/drizzle/auth.ts && biome format --write ./src/lib/drizzle/auth.ts",
    "auth:secret": "bunx auth@latest secret",
    "build": "vite build",
    "build:bump": "bun pm version patch --no-git-tag-version",
    "check": "biome check && bun check-types",
    "check:fix": "biome check --write",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .mastra && rm -rf .nitro && rm -rf .tanstack && rm -rf .output && rm -rf node_modules/.vite",
    "clean:deep": "rm -rf .mastra && rm -rf .nitro && rm -rf .tanstack && rm -rf .output && rm -rf node_modules/.vite && rm -rf node_modules bun.lock && bun install && bun outdated && bun check",
    "compose:db:down": "docker compose --env-file devconfig/standalone-db.env -f docker/standalone-db-compose.yaml down -v",
    "compose:db:up": "docker compose --env-file devconfig/standalone-db.env -f docker/standalone-db-compose.yaml up -d",
    "compose:full:down": "docker compose --env-file devconfig/full.env -f docker/full-compose.yaml down -v",
    "compose:full:up": "docker compose --env-file devconfig/full.env -f docker/full-compose.yaml up -d",
    "compose:garage:down": "docker compose --env-file devconfig/standalone-garage.env -f docker/standalone-garage-compose.yaml down -v",
    "compose:garage:up": "docker compose --env-file devconfig/standalone-garage.env -f docker/standalone-garage-compose.yaml up -d",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && bun format",
    "db:get-data": "bun devtools/get-drizzle-data.ts",
    "db:push": "bun --env-file=.env drizzle-kit push",
    "db:run:migrations": "bun src/base/cli/run-migrations.ts",
    "dev": "bun --bun vite dev --strictPort --port 8088",
    "dev:lt": "concurrently --names 'vi,lt' --prefix-colors 'blue,yellow' --prefix '{time}-{pid} {name}' '. ./devconfig/localtunnel-settings.sh && bun dev' 'sleep 3 && bun lt' --restart-tries 3 --restart-after exponential 'exit 1'",
    "docker:build": "./devtools/docker-build.sh",
    "docker:remove": ". ./devconfig/docker-settings.sh && docker network rm \"${IMAGE_NAME}-development-network\"",
    "docker:run": ". ./devconfig/docker-settings.sh && docker rm -f \"${IMAGE_NAME}-standalone-app\" || true && docker run -d -p 8088:8088 --env-file .env --network \"${IMAGE_NAME}-development-network\" --name \"${IMAGE_NAME}-standalone-app\" \"${IMAGE_NAME}\"",
    "docker:setup": ". ./devconfig/docker-settings.sh && docker network create \"${IMAGE_NAME}-development-network\"",
    "format": "biome format --write",
    "lint": "biome lint",
    "lt": ". ./devconfig/localtunnel-settings.sh && ./node_modules/.bin/lt --port 8088 --subdomain ${LOCALTUNNEL_SUBDOMAIN} --print-requests",
    "make": "bun run clean && bun run format && bun run build && bun run post-build-actions",
    "post-build-actions": "./devtools/post-build-actions.sh",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "cp .env ./.output/server/.env && cd ./.output/server/ && export NODE_ENV=production && bun index.mjs",
    "start-lt": "concurrently --names 'vi,lt' --prefix-colors 'blue,yellow' --prefix '{time}-{pid} {name}' '. ./devconfig/localtunnel-settings.sh && bun start' 'sleep 3 && bun lt' --restart-tries 3 --restart-after exponential 'exit 1'",
    "ui": "bunx shadcn@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@hookform/resolvers": "5.9.1",
    "@react-email/components": "1.0.12",
    "@rolldown/plugin-babel": "0.2.4",
    "@shadcn/react": "0.3.1",
    "@t3-oss/env-core": "0.13.11",
    "@tabler/icons-react": "3.47.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/react-table": "9.2.4",
    "@turf/buffer": "7.4.0",
    "@turf/circle": "7.4.0",
    "@turf/turf": "7.4.0",
    "@vitejs/plugin-react": "6.1.1",
    "async-retry": "1.3.3",
    "better-auth": "1.7.5",
    "chalk": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-react": "8.6.0",
    "eventemitter3": "5.0.4",
    "framer-motion": "13.4.0",
    "input-otp": "1.5.0",
    "libphonenumber-js": "1.13.13",
    "liquidjs": "10.29.0",
    "lucide-react": "1.47.0",
    "maplibre-gl": "6.10.0",
    "next-themes": "0.4.6",
    "nitro": "3.0.260903-beta",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-image-file-resizer": "0.4.8",
    "react-map-gl": "8.1.3",
    "react-resizable-panels": "4.13.1",
    "recharts": "3.10.1",
    "redaxios": "0.5.1",
    "resend": "6.28.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "ua-parser-js": "2.0.10",
    "uuid": "14.0.2",
    "vaul": "1.1.2",
    "vite": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-form-devtools": "0.2.34",
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/async-retry": "1.4.9",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "localtunnel": "2.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.2"
}
